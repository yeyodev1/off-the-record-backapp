# --- Base ---------------------------------------------------------------
DB_URI=mongodb://localhost:27017/off-the-record
PORT=8100
JWT_SECRET=your_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key

# --- Cuentas ------------------------------------------------------------
# Las cuentas se siembran directamente en MongoDB (ver src/config/bootstrap.ts).
# Todas usan la contraseña 123456789. No se configuran por variables de entorno.

# --- CORS / enlaces públicos -------------------------------------------
CORS_ORIGINS=http://localhost:5173,https://off-the-record-frontapp.vercel.app
CORS_ALLOW_VERCEL_PREVIEWS=true
# Base del frontend, usada para armar los enlaces que se envían por Signal
PUBLIC_APP_URL=https://off-the-record-frontapp.vercel.app

# --- Cloudinary (adjuntos y salidas de IA) ------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- IA -----------------------------------------------------------------
# Una sola clave de Google cubre TODO el agente: texto, infografías,
# imágenes, audio (TTS) y video (Veo). Se saca en aistudio.google.com
GOOGLE_API_KEY=
AI_TEXT_PROVIDER=gemini

# Opcionales: modelos alternativos
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# Proveedores alternativos (opcionales)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Reportes automáticos -----------------------------------------------
# Hora local a la que se genera el reporte del día anterior
REPORT_DAILY_HOUR=7
REPORT_TIMEZONE_OFFSET=-5

SLACK_ERROR_WEBHOOK=
# Los refresh tokens duran 14 días; el access token se renueva solo en el frontend.
